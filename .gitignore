# (share installers via GitHub Releases, not the git repo)
dist/
out/
release/
*.exe
*.msi
*.dmg
*.AppImage
*.blockmap
*.zip

# Electron / electron-builder local caches
.electron/
.electron-builder/

# Secrets & local env (never commit tokens)
.env
.env.*
!.env.example
*.pem
*.p12
*.key
*.pfx
*.token
GH_TOKEN
GITHUB_TOKEN
.npmrc
auth.json
credentials.json
**/secrets/**

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Tests / coverage
coverage/
.nyc_output/

# Editors & OS
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# Local tooling noise
.cursor/

# Misc local-only files
*.local
